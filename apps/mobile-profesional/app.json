{
  "expo": {
    "name": "Geras - Profesionales",
    "slug": "geras-profesional",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "geras-profesional",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1D3557"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "cl.geras.profesional"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D3557"
      },
      "package": "cl.geras.profesional"
    },
    "web": {
      "bundler": "metro",
      "output": "server"
    }
  }
}
