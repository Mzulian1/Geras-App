PORT=4000
NODE_ENV=development

# Clerk
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Firma del webhook (Clerk Dashboard > Webhooks > tu endpoint > Signing Secret)
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Supabase
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=eyJxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Resend
RESEND_API_KEY=re_xxx

# CORS: orígenes permitidos separados por coma. Sin esta variable se usa
# http://localhost:3000 (admin-panel en dev) como único origen permitido.
CORS_ALLOWED_ORIGINS=http://localhost:3000
