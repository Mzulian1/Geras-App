{
  "name": "geras-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "clean": "turbo clean",
    "dev:mobile-familia": "turbo dev --filter=mobile-familia",
    "dev:mobile-profesional": "turbo dev --filter=mobile-profesional",
    "dev:admin": "turbo dev --filter=admin-panel",
    "dev:server": "turbo dev --filter=server"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  },
  "overrides": {
    "metro": "0.83.7",
    "metro-config": "0.83.7",
    "metro-core": "0.83.7",
    "metro-runtime": "0.83.7",
    "metro-resolver": "0.83.7",
    "metro-source-map": "0.83.7",
    "metro-transform-worker": "0.83.7",
    "metro-babel-transformer": "0.83.7",
    "metro-cache": "0.83.7",
    "metro-cache-key": "0.83.7",
    "metro-file-map": "0.83.7",
    "metro-symbolicate": "0.83.7",
    "metro-transform-plugins": "0.83.7",
    "expo": "54.0.36",
    "expo-font": "14.0.12",
    "react-native-safe-area-context": "5.6.2"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "comment-json": "^5.0.0"
  }
}
